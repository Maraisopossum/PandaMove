<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Thème de base — utilisé par l'application -->
    <style name="Theme.PandaFit" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Thème de lancement — SplashScreen API Android 12+ -->
    <style name="Theme.PandaFit.Launch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#8B9BAC</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_transparent</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.PandaFit</item>
    </style>

</resources>
