<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nécessaire pour tout foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Type "health" requis sur Android 14+ (API 34+) pour un service fitness -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Affichage des notifications sur Android 13+ (API 33+) — permission à demander au runtime -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".service.TimerForegroundService"
            android:foregroundServiceType="health"
            android:exported="false" />
    </application>

</manifest>
